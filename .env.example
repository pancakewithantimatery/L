# VENICE_API_KEY: Required for Venice.ai API calls.
VENICE_API_KEY=PLACEHOLDER_VENICE_KEY

# GEMINI_API_KEY: Injected by AI Studio default tier or configured in Settings.
GEMINI_API_KEY=DEFAULT_GEMINI_KEY

# OPENROUTER_API_KEY: OpenRouter.ai API key for accessing multi-model routing.
OPENROUTER_API_KEY=PLACEHOLDER_OPENROUTER_KEY

# OLLAMA_HOST_URL: Local Ollama server endpoint (e.g. http://10.0.2.2:11434 for emulator, http://localhost:11434 or LAN IP)
OLLAMA_HOST_URL=http://10.0.2.2:11434
